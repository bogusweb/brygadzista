PORT=3000
DATABASE_URL=postgres://brygadzista:brygadzista@localhost:5432/brygadzista
DATA_DIR=./data
DASHBOARD_DIR=../dashboard/dist
# Emergency admin access (create the first owner account with it). APP_TOKEN is the old shared app token:
# leave it empty once the app logs in with accounts (in production it is off unless set).
ADMIN_TOKEN=change-me-admin
APP_TOKEN=
OPENROUTER_API_KEY=
# Optional overrides (defaults shown)
AGENT_MODEL=google/gemini-3.1-flash-lite
AGENT_PROVIDER=google-vertex/eu
VISION_MODEL=google/gemini-3.1-flash-lite
VISION_PROVIDER=google-vertex/eu
EMBEDDING_MODEL=google/gemini-embedding-2
# puste = dowolny dostawca bez retencji danych (może być poza UE)
EMBEDDING_PROVIDER=
INDEX_CONCURRENCY=2
# Large PDFs (#9)
MAX_UPLOAD_MB=1024
MAX_PAGES=3000
INDEX_COST_PER_PAGE_USD=0.03
INDEX_SECONDS_PER_PAGE=20
LLM_TIMEOUT_MS=180000
LLM_MAX_RETRIES=5
LLM_RETRY_BASE_MS=2000
PDF_TOOL_TIMEOUT_MS=120000
MAX_CONSECUTIVE_PAGE_FAILURES=5
# User accounts (#10)
SESSION_TTL_DAYS=30
RATE_LIMIT_CHAT_PER_MINUTE=10
RATE_LIMIT_UPLOADS_PER_HOUR=30
RATE_LIMIT_LOGIN_PER_15_MIN=10
RATE_LIMIT_DIARY_PER_HOUR=60
# Longest voice note for the daily log, in MB
MAX_DIARY_AUDIO_MB=25
COPILOTKIT_TELEMETRY_DISABLED=true
# Dev only: answer chats with a scripted test agent instead of the model (ignored when NODE_ENV=production)
FAKE_AGENT=0
