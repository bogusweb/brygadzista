PORT=3000
DATABASE_URL=postgres://brygadzista:brygadzista@localhost:5432/brygadzista
DATA_DIR=./data
DASHBOARD_DIR=../dashboard/dist
ADMIN_TOKEN=change-me-admin
APP_TOKEN=change-me-app
OPENROUTER_API_KEY=
# Optional overrides (defaults shown)
AGENT_MODEL=anthropic/claude-opus-5.5
AGENT_PROVIDER=google-vertex/europe
INDEX_MODEL=anthropic/claude-sonnet-5.5
INDEX_PROVIDER=google-vertex/europe
EMBEDDING_MODEL=google/gemini-embedding-2
EMBEDDING_PROVIDER=google-vertex/eu
INDEX_CONCURRENCY=2
# Large PDFs (#9)
MAX_UPLOAD_MB=1024
MAX_PAGES=3000
INDEX_COST_PER_PAGE_USD=0.03
INDEX_SECONDS_PER_PAGE=20
LLM_TIMEOUT_MS=180000
LLM_MAX_RETRIES=5
LLM_RETRY_BASE_MS=2000
PDF_TOOL_TIMEOUT_MS=120000
MAX_CONSECUTIVE_PAGE_FAILURES=5
COPILOTKIT_TELEMETRY_DISABLED=true
