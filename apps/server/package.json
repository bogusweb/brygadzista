{
  "name": "@brygadzista/server",
  "private": true,
  "type": "module",
  "exports": {
    "./a2ui-catalog": "./src/a2ui-catalog.ts"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:db": "docker run -d --rm --name brygadzista-test-db -e POSTGRES_USER=brygadzista -e POSTGRES_PASSWORD=brygadzista -e POSTGRES_DB=brygadzista_test -p 5433:5432 pgvector/pgvector:pg16"
  },
  "dependencies": {
    "@a2ui/web_core": "0.10.4",
    "@ag-ui/client": "1.0.2",
    "@copilotkit/runtime": "1.79.1",
    "@hono/node-server": "^2.1.5",
    "@node-rs/argon2": "^2.2.2",
    "@openrouter/ai-sdk-provider": "2.10.0",
    "ai": "6.0.311",
    "hono": "^4.13.13",
    "postgres": "^3.4.9",
    "rxjs": "7.8.1",
    "zod": "^4.6.7",
    "zod-to-json-schema": "3.25.2",
    "zod3": "npm:zod@3.25.76"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}
